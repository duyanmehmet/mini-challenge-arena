        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "74921537013-lr1636vf8ljjho8t63alr6dcolm4pg1o.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "74921537013-uml6bmur7undlh8pqp9tecr9tu4iq817.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
