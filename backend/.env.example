# Veritabanı
DATABASE_URL=postgresql://user:password@localhost:5432/mca

# JWT
JWT_SECRET=your-super-secret-key-minimum-32-characters-long
JWT_EXPIRES_IN=30d

# E-posta (Gmail için uygulama şifresi: myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_USER=your@gmail.com
EMAIL_PASS=your-app-password-16-chars

# Uygulama
NODE_ENV=development
PORT=3000
APP_URL=https://minichallengearena.com

# Redis (isteğe bağlı — yoksa önbellek devre dışı)
REDIS_URL=redis://localhost:6379
