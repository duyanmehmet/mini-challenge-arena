# Railway PostgreSQL: dashboard > Variables > DATABASE_URL (otomatik eklenir)
DATABASE_URL=postgresql://user:password@host:5432/railway

# En az 32 karakter rastgele string (openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=30d

# Gmail App Password: Gmail > Hesap > Guvenlik > Uygulama Sifreleri
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password

NODE_ENV=production
PORT=3000
